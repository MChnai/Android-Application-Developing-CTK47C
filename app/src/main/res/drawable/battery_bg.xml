<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:right="3dp"> <shape android:shape="rectangle">
        <corners android:radius="2dp" />
        <stroke
            android:width="1.5dp"
            android:color="@color/white_blue" />
        <solid android:color="@android:color/transparent" />
        <size android:width="22dp" android:height="12dp" />
    </shape>
    </item>

    <item
        android:gravity="right|center_vertical"
        android:width="1.8dp"
        android:height="5dp">
        <shape android:shape="rectangle">
            <corners
                android:topRightRadius="0.5dp"
                android:bottomRightRadius="0.5dp" />
            <solid android:color="@color/white_blue" />
        </shape>
    </item>

</layer-list>